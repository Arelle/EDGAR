  },
  "devDependencies": {
    "esbuild": "^0.20.2",
    "jest": "^29.7.0"
  },
  "jest": {
    "transform": { "\\.m?js$": "<rootDir>/test/esbuild-transformer.cjs" },
    "modulePaths": ["<rootDir>/node_modules"],
